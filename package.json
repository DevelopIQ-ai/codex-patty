{
  "name": "codex-patty",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "corepack pnpm -r build",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "test:unit": "corepack pnpm --filter @patty/daemon test:unit",
    "test:contract": "corepack pnpm --filter @patty/daemon test:contract",
    "test:integration": "corepack pnpm --filter @patty/daemon test:integration",
    "test:e2e:fake": "corepack pnpm --filter @patty/daemon test:e2e:fake",
    "test:live": "corepack pnpm --filter @patty/daemon test:live",
    "openapi:lint": "redocly lint packages/contracts/openapi/codex-patty.openapi.yaml",
    "test:pack": "corepack pnpm pack:npm && node scripts/pack-smoke.mjs",
    "demo": "corepack pnpm build && node apps/daemon/dist/src/main.js --fake=work-sub:0.82:190 --fake=personal-sub:0.55:41 --fake=team-sub:0.31:14",
    "pack:npm": "corepack pnpm build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@openai/codex": "0.145.0",
    "@redocly/cli": "^1.34.17",
    "@types/node": "^22.15.0",
    "ajv": "8.17.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
