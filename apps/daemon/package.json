{"name": "@patty/daemon", "version": "0.1.0", "type": "module", "bin": {"pattyd": "./dist/src/main.js"}, "scripts": {"build": "tsc -p tsconfig.json && chmod +x dist/src/main.js", "lint": "tsc --noEmit -p tsconfig.json", "typecheck": "tsc --noEmit -p tsconfig.json", "test:unit": "vitest run test/unit.test.ts", "test:contract": "vitest run test/contract.test.ts", "test:integration": "tsc -p tsconfig.json && vitest run test/integration.test.ts", "test:e2e:fake": "vitest run test/e2e.test.ts", "test:live": "corepack pnpm --filter @patty/daemon build && node ../../scripts/live-harness.mjs"}, "dependencies": {"@patty/contracts": "workspace:*"}}